# Copia este archivo como keystore.properties (ignorado por git) para firmar el build de release.
# Genera el keystore una sola vez y guárdalo fuera del repositorio o en esta carpeta (los *.jks se ignoran):
#   keytool -genkeypair -v -keystore upad-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upad
#
# storeFile es relativo a la raíz del proyecto.
storeFile=upad-release.jks
storePassword=tu_contraseña_del_keystore
keyAlias=upad
keyPassword=tu_contraseña_de_la_clave
