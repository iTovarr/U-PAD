<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 11 o inferior: se excluye todo de Auto Backup como defensa adicional
   a android:allowBackup="false". Ver data_extraction_rules.xml para API 31+.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
