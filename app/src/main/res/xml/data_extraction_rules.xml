<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ (API 31): la app guarda datos de menores (rol, vínculo con el
   tutor, estado de la sesión), por lo que no se copian a la nube ni se
   transfieren a otro dispositivo. Los datos reales viven en Firestore.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
