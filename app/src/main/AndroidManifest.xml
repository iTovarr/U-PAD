<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Rastreo del dispositivo del niño mediante un servicio en primer plano -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Necesario desde Android 11 para encontrar el motor de voz (lectura en voz alta del modo niño) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".UPadApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/upad_icono"
        android:label="@string/app_name"
        android:roundIcon="@drawable/upad_icono"
        android:supportsRtl="true"
        android:theme="@style/Theme.App.Start">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.App.Start">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Notificaciones push: canal por defecto y servicio que recibe los mensajes -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="upad_notifications_channel" />

        <service
            android:name=".notifications.UPadMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <service
            android:name=".location.LocationTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <receiver
            android:name=".widget.ParentRoutineWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label_progress">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.upad.widget.ACTION_REFRESH" />
                <action android:name="com.example.upad.widget.ACTION_DATA_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/parent_routine_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.ChildSessionMonitorWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label_session">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.upad.widget.session.ACTION_REFRESH" />
                <action android:name="com.example.upad.widget.ACTION_DATA_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_child_session_monitor_info" />
        </receiver>

        <receiver
            android:name=".widget.PremiumProgressWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label_progress_premium">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.upad.widget.premium.ACTION_REFRESH" />
                <action android:name="com.example.upad.widget.ACTION_DATA_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/premium_progress_widget_info" />
        </receiver>
    </application>

</manifest>